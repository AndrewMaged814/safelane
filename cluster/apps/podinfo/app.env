# podinfo — the demo application used for the guarded-rollout demonstration.
NAMESPACE=podinfo
ROLLOUT=podinfo
STABLE_SERVICE=podinfo-stable
CANARY_SERVICE=podinfo-canary
# The oldest of the images published from AndrewMaged814/podinfo. Pinned by
# digest, not tag, for the same reason SafeLane never trusts a mutable tag.
BASELINE_DIGEST="sha256:99f5be634b8215dc0dff8c9e1c853da1fd4b7fffdb23181afcd9fe8e39cbaf3d"
BASELINE_IMAGE="ghcr.io/andrewmaged814/podinfo@${BASELINE_DIGEST}"
# Traffic reaches the canary through ingress-nginx, so the load generator must
# send this Host header; the Ingress host is not in-cluster resolvable DNS.
LOADGEN_MODE=ingress
LOADGEN_HOST=podinfo.production.svc.cluster.local
PROBE_IMAGE_REPO=
