# safelane-demo-api — the application `safelane setup` is shaped around: it is
# the only one whose routes compile to a semantic runtime assertion.
NAMESPACE=safelane-demo-api
ROLLOUT=safelane-demo-api
STABLE_SERVICE=safelane-demo-api-stable
CANARY_SERVICE=safelane-demo-api-canary
BASELINE_TAG="sha-726662d2c396b54cfc047721a41bc67e77643924"
BASELINE_IMAGE_REPO="ghcr.io/andrewmaged814/safelane-demo-api"
# No ingress: weights are approximated by replica count for this app.
LOADGEN_MODE=service
LOADGEN_HOST=
# `safelane setup` writes a REPLACE_WITH_PUBLISHED_DIGEST placeholder for this
# image and nothing substitutes it since the demo command was removed.
PROBE_IMAGE_REPO=andrewmaged814/safelane-demo-probe
