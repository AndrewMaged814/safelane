apiVersion: argoproj.io/v1alpha1
kind: AnalysisTemplate
metadata:
  name: {{ .AnalysisTemplateName }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Application }}
    app.kubernetes.io/part-of: safelane
spec:
  args:
    - name: service-name
  metrics:
    - name: request-success-rate
      interval: 30s
      # No `count` on purpose: this is a BACKGROUND analysis and must keep
      # measuring for the whole rollout. With a fixed count it finished early,
      # while the canary was still new, and every later weight then rolled out
      # completely unanalysed.
      #
      # initialDelay is a full rate-window clear of the canary Service's
      # endpoint flip. The Service only selects the canary pod once it is
      # Ready, so a window straddling that moment still contains stable
      # traffic recorded under the canary Service label, which reads as
      # healthy no matter how broken the canary is.
      initialDelay: 60s
      successCondition: len(result) > 0 && result[0] >= 0.99
      failureLimit: 1
      provider:
        prometheus:
          address: http://prometheus.monitoring.svc.cluster.local:9090
          query: >-
            sum(rate(http_requests_total{namespace="{{ .Namespace }}",service="{{ .CanaryServiceName }}",status!~"5.."}[30s]))
            /
            sum(rate(http_requests_total{namespace="{{ .Namespace }}",service="{{ .CanaryServiceName }}"}[30s]))
