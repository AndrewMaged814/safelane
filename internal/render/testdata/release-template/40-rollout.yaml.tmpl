apiVersion: argoproj.io/v1alpha1
kind: Rollout
metadata:
  name: {{ .RolloutName }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Application }}
    app.kubernetes.io/part-of: safelane
    safelane.dev/environment: {{ .Environment }}
  annotations:
    safelane.dev/source-repository: {{ .SourceRepository }}
    safelane.dev/source-revision: {{ .SourceRevision }}
    safelane.dev/target-cluster: {{ .Cluster }}
spec:
  replicas: 4
  revisionHistoryLimit: 5
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Application }}
  strategy:
    canary:
      canaryService: {{ .CanaryServiceName }}
      stableService: {{ .StableServiceName }}
      trafficRouting:
        nginx:
          stableIngress: {{ .IngressName }}
      analysis:
        templates:
          - templateName: {{ .AnalysisTemplateName }}
        args:
          - name: service-name
            value: {{ .CanaryServiceName }}
      steps:
{{- range .Steps }}
        - setWeight: {{ . }}
        - pause:
            duration: 60s
{{- end }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Application }}
        app.kubernetes.io/part-of: safelane
    spec:
      containers:
        - name: {{ .Application }}
          image: {{ .ImageReference }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              protocol: TCP
              containerPort: 9898
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
