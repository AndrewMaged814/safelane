apiVersion: v1
kind: Service
metadata:
  name: {{ .StableServiceName }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Application }}
    app.kubernetes.io/part-of: safelane
    safelane.dev/environment: {{ .Environment }}
    safelane.dev/service-role: stable
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ .Application }}
  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: http
