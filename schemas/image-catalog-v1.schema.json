{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "application_images", "probe_images"],
  "properties": {
    "schema_version": {"const": "1"}, "catalog_version": {"const": "2026.08.1"},
    "application_images": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/application"}},
    "probe_images": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/probe"}}
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "service", "source_revision", "image_ref", "image_id", "runtime_image_id", "oci_revision"],
      "properties": {
        "repository": {"const": "AndrewMaged814/safelane-demo"}, "service": {"const": "demo-api"},
        "source_revision": {"$ref": "#/$defs/git_sha"}, "image_ref": {"type": "string"},
        "image_id": {"$ref": "#/$defs/sha256"}, "runtime_image_id": {"$ref": "#/$defs/sha256"},
        "oci_revision": {"$ref": "#/$defs/git_sha"}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "probe_id", "image_ref", "image_id", "runtime_image_id"],
      "properties": {
        "key": {"const": "demo-api-public-quote-probe@2026.08.1"}, "probe_id": {"const": "demo-api-public-quote-v1"},
        "image_ref": {"const": "safelane-http-probe:2026.08.1"}, "image_id": {"$ref": "#/$defs/sha256"},
        "runtime_image_id": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
