{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safelane.dev/schemas/argo-rollout-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "argoproj.io/v1alpha1"},
    "kind": {"const": "Rollout"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "annotations"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "safelane.dev/assessment-id",
            "safelane.dev/assessment-result-sha256",
            "safelane.dev/decision-sha256",
            "safelane.dev/head-sha",
            "safelane.dev/policy-sha256",
            "safelane.dev/image-catalog-sha256"
          ],
          "properties": {
            "safelane.dev/assessment-id": {"type": "string", "minLength": 1},
            "safelane.dev/assessment-result-sha256": {"$ref": "#/$defs/hash"},
            "safelane.dev/decision-sha256": {"$ref": "#/$defs/hash"},
            "safelane.dev/head-sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "safelane.dev/policy-sha256": {"$ref": "#/$defs/hash"},
            "safelane.dev/image-catalog-sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "selector", "template", "strategy"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "selector": {"$ref": "#/$defs/selector"},
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata", "spec"],
          "properties": {
            "metadata": {"$ref": "#/$defs/pod_metadata"},
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": ["containers"],
              "properties": {
                "containers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "image"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"}
                    }
                  }
                }
              }
            }
          }
        },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canary"],
          "properties": {
            "canary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxSurge", "maxUnavailable", "steps"],
              "properties": {
                "maxSurge": {"type": "integer", "minimum": 0},
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object", "additionalProperties": false,
                        "required": ["setWeight"],
                        "properties": {"setWeight": {"type": "integer", "minimum": 1, "maximum": 100}}
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "required": ["analysis"],
                        "properties": {
                          "analysis": {
                            "type": "object", "additionalProperties": false,
                            "required": ["templates"],
                            "properties": {
                              "templates": {
                                "type": "array", "minItems": 1, "maxItems": 1,
                                "items": {
                                  "type": "object", "additionalProperties": false,
                                  "required": ["templateName"],
                                  "properties": {"templateName": {"type": "string", "minLength": 1}}
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "minProperties": 1,
          "maxProperties": 1
        }
      }
    },
    "pod_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels"],
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "minProperties": 1,
          "maxProperties": 1
        }
      }
    }
  }
}
