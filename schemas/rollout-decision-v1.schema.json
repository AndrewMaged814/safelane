{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safelane.dev/schemas/rollout-decision-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "assessment_input_sha256", "assessment_result_sha256", "repository", "pull_request", "base_sha", "head_sha", "policy", "trusted_probe_catalog", "service", "tier", "profile", "trusted_probe", "resolution", "authorization_signature"],
  "properties": {
    "schema_version": {"const": "rollout-decision-v1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_input_sha256": {"$ref": "#/$defs/hash"},
    "assessment_result_sha256": {"$ref": "#/$defs/hash"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_sha": {"$ref": "#/$defs/git_sha"},
    "head_sha": {"$ref": "#/$defs/git_sha"},
    "policy": {"$ref": "#/$defs/provenance"},
    "trusted_probe_catalog": {"$ref": "#/$defs/provenance"},
    "service": {"type": "string", "minLength": 1},
    "tier": {"enum": ["safe", "guarded", "risky"]},
    "profile": {"$ref": "#/$defs/profile"},
    "trusted_probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
    "resolution": {"$ref": "#/$defs/resolution"},
    "authorization_signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["version", "source_revision", "sha256"], "properties": {"version": {"type": "string"}, "source_revision": {"$ref": "#/$defs/git_sha"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["name", "source", "traffic_router", "replicas", "max_surge", "max_unavailable", "stages"], "properties": {"name": {"enum": ["Fast", "Guarded", "Strict"]}, "source": {"const": "repository_policy"}, "traffic_router": {"const": "none"}, "replicas": {"type": "integer", "minimum": 1}, "max_surge": {"type": "integer", "minimum": 0}, "max_unavailable": {"type": "integer", "minimum": 0}, "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["set_weight", "exposure_pods", "analysis"], "properties": {"set_weight": {"type": "integer"}, "exposure_pods": {"type": "integer"}, "analysis": {"type": "boolean"}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["id", "catalog_entry_sha256", "analysis_template", "selection_source"], "properties": {"id": {"type": "string"}, "catalog_entry_sha256": {"$ref": "#/$defs/hash"}, "analysis_template": {"type": "string"}, "selection_source": {"enum": ["ai_safety_case", "policy_fallback"]}}},
    "resolution": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "selected_profile", "resolved_at"], "properties": {"type": {"const": "automatic"}, "selected_profile": {"const": "Fast"}, "resolved_at": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "action", "actor", "selected_profile", "resolved_at"], "properties": {"type": {"const": "human"}, "action": {"const": "approve"}, "actor": {"type": "string", "minLength": 1}, "selected_profile": {"enum": ["Guarded", "Strict"]}, "resolved_at": {"type": "string"}}}
      ]
    }
  }
}
