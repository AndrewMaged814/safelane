{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "assessed_at", "policy_version", "assessment_input_sha256", "assessment_result_sha256", "change", "evidence", "ai_findings", "selected_safeguard", "policy_trace", "policy_result", "rollout_options", "review"],
  "properties": {
    "schema_version": {"const": "2"}, "assessment_id": {"type": "string", "minLength": 1},
    "assessed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "policy_version": {"const": "2026.08.3"},
    "assessment_input_sha256": {"$ref": "#/$defs/sha256"}, "assessment_result_sha256": {"$ref": "#/$defs/sha256"},
    "change": {"$ref": "#/$defs/change"}, "evidence": {"$ref": "#/$defs/evidence"},
    "ai_findings": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "selected_safeguard": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/safeguard"}]},
    "policy_trace": {"$ref": "#/$defs/policy_trace"}, "policy_result": {"$ref": "#/$defs/policy_result"},
    "rollout_options": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/profile"}},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "if": {"properties": {"policy_result": {"properties": {"final_tier": {"const": "safe"}}}}, "required": ["policy_result"]},
      "then": {"properties": {"policy_result": {"properties": {"minimum_profile": {"const": "Fast"}, "fast_eligible": {"const": true}}}, "rollout_options": {"minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/fast_profile"}], "items": false}, "review": {"properties": {"status": {"const": "resolved"}, "resolution": {"allOf": [{"$ref": "#/$defs/resolution"}, {"properties": {"type": {"const": "automatic"}, "selected_profile": {"const": "Fast"}}}]}}}}}
    },
    {
      "if": {"properties": {"policy_result": {"properties": {"final_tier": {"const": "guarded"}}}}, "required": ["policy_result"]},
      "then": {"properties": {"policy_result": {"properties": {"minimum_profile": {"const": "Guarded"}, "fast_eligible": {"const": false}}}, "rollout_options": {"minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/guarded_profile"}, {"$ref": "#/$defs/strict_profile"}], "items": false}, "review": {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"properties": {"resolution": {"allOf": [{"$ref": "#/$defs/resolution"}, {"properties": {"type": {"const": "human"}, "selected_profile": {"enum": ["Guarded", "Strict"]}}}]}}}}}}
    },
    {
      "if": {"properties": {"policy_result": {"properties": {"final_tier": {"const": "risky"}}}}, "required": ["policy_result"]},
      "then": {"properties": {"policy_result": {"properties": {"minimum_profile": {"const": "Strict"}, "fast_eligible": {"const": false}}}, "rollout_options": {"minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/strict_profile"}], "items": false}, "review": {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"properties": {"resolution": {"allOf": [{"$ref": "#/$defs/resolution"}, {"properties": {"type": {"const": "human"}, "selected_profile": {"const": "Strict"}}}]}}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "change": {"type": "object", "additionalProperties": false, "required": ["repository", "pull_request", "base_sha", "head_sha", "files_changed", "lines_changed", "services", "all_paths_recognized"], "properties": {"repository": {"const": "AndrewMaged814/safelane-demo"}, "pull_request": {"type": "integer", "minimum": 1}, "base_sha": {"$ref": "#/$defs/git_sha"}, "head_sha": {"$ref": "#/$defs/git_sha"}, "files_changed": {"type": "integer", "minimum": 0}, "lines_changed": {"type": "integer", "minimum": 0}, "services": {"type": "array", "items": {"const": "demo-api"}, "maxItems": 1}, "all_paths_recognized": {"type": "boolean"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["git_diff_sha256", "ai_status", "ai_model_digest", "prompt_sha256", "response_schema_sha256", "incident_history"], "properties": {"git_diff_sha256": {"$ref": "#/$defs/sha256"}, "ai_status": {"enum": ["complete", "partial", "unavailable", "skipped_invalid_diff", "skipped_over_budget"]}, "ai_model_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "prompt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "response_schema_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "incident_history": {"const": "disabled_by_policy"}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["file", "side", "line", "text"], "properties": {"file": {"type": "string"}, "side": {"enum": ["removed", "added"]}, "line": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "spans", "source_reference_verified"], "properties": {"id": {"const": "finding-001"}, "kind": {"const": "breaking_api"}, "spans": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/span"}}, "source_reference_verified": {"const": true}}},
    "safeguard": {"type": "object", "required": ["finding_ref", "selection_source", "hypothesis_kind", "hypothesis", "verification_intent_kind", "probe_id", "catalog_entry_sha256", "probe_preview", "approval_question_kind", "approval_question", "remediation_kind", "remediation"], "additionalProperties": false, "properties": {"finding_ref": {"const": "finding-001"}, "selection_source": {"const": "ai_safeguard"}, "hypothesis_kind": {"const": "removed_http_route_unavailable"}, "hypothesis": {"const": "Existing callers of GET /v1/quote may receive a non-success response."}, "verification_intent_kind": {"const": "preserve_removed_http_route"}, "probe_id": {"const": "demo-api-public-quote-v1"}, "catalog_entry_sha256": {"$ref": "#/$defs/sha256"}, "probe_preview": {"const": {"method": "GET", "path": "/v1/quote", "expected_status": 200, "attempts": 3, "interval_seconds": 10, "failure_allowance": 1, "request_timeout_seconds": 2, "active_deadline_seconds": 45, "canary_only": true}}, "approval_question_kind": {"const": "confirm_callers_migrated"}, "approval_question": {"const": "Have all callers migrated away from GET /v1/quote?"}, "remediation_kind": {"const": "retain_removed_route_as_alias"}, "remediation": {"const": "Retain GET /v1/quote as an alias while introducing GET /v2/quote, then reassess."}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "minimum_tier", "reason"], "properties": {"rule_id": {"type": "string"}, "minimum_tier": {"enum": ["guarded", "risky"]}, "reason": {"type": "string"}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["rule_id", "tier", "reason"], "properties": {"rule_id": {"enum": ["scope.low", "scope.medium", "scope.high"]}, "tier": {"enum": ["safe", "guarded", "risky"]}, "reason": {"type": "string"}}},
    "policy_trace": {"type": "object", "additionalProperties": false, "required": ["baseline", "safety_floors"], "properties": {"baseline": {"$ref": "#/$defs/baseline"}, "safety_floors": {"type": "array", "items": {"$ref": "#/$defs/rule"}}}},
    "policy_result": {"type": "object", "additionalProperties": false, "required": ["final_tier", "minimum_profile", "evidence_confidence", "fast_eligible", "primary_reason"], "properties": {"final_tier": {"enum": ["safe", "guarded", "risky"]}, "minimum_profile": {"enum": ["Fast", "Guarded", "Strict"]}, "evidence_confidence": {"enum": ["high", "low"]}, "fast_eligible": {"type": "boolean"}, "primary_reason": {"type": "string"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["set_weight", "exposure_pods", "analysis"], "properties": {"set_weight": {"enum": [20, 40, 60, 100]}, "exposure_pods": {"enum": [1, 2, 3, 5]}, "analysis": {"type": "boolean"}}},
    "fast_profile": {"const": {"name": "Fast", "source": "built_in", "traffic_router": "none", "replicas": 5, "max_surge": 1, "max_unavailable": 0, "stages": [{"set_weight": 100, "exposure_pods": 5, "analysis": false}]}},
    "guarded_profile": {"const": {"name": "Guarded", "source": "built_in", "traffic_router": "none", "replicas": 5, "max_surge": 1, "max_unavailable": 0, "stages": [{"set_weight": 40, "exposure_pods": 2, "analysis": true}, {"set_weight": 100, "exposure_pods": 5, "analysis": false}]}},
    "strict_profile": {"const": {"name": "Strict", "source": "built_in", "traffic_router": "none", "replicas": 5, "max_surge": 1, "max_unavailable": 0, "stages": [{"set_weight": 20, "exposure_pods": 1, "analysis": true}, {"set_weight": 40, "exposure_pods": 2, "analysis": true}, {"set_weight": 60, "exposure_pods": 3, "analysis": true}, {"set_weight": 100, "exposure_pods": 5, "analysis": false}]}},
    "profile": {"oneOf": [{"$ref": "#/$defs/fast_profile"}, {"$ref": "#/$defs/guarded_profile"}, {"$ref": "#/$defs/strict_profile"}]},
    "resolution": {"type": "object", "additionalProperties": false, "required": ["type", "selected_profile", "resolved_at", "assessment_id", "head_sha", "assessment_input_sha256", "assessment_result_sha256"], "properties": {"type": {"enum": ["automatic", "human"]}, "selected_profile": {"enum": ["Fast", "Guarded", "Strict"]}, "resolved_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "assessment_id": {"type": "string", "minLength": 1}, "head_sha": {"$ref": "#/$defs/git_sha"}, "assessment_input_sha256": {"$ref": "#/$defs/sha256"}, "assessment_result_sha256": {"$ref": "#/$defs/sha256"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "resolution"], "properties": {"status": {"enum": ["unresolved", "resolved"]}, "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/resolution"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "unresolved"}}}, "then": {"properties": {"resolution": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"properties": {"resolution": {"$ref": "#/$defs/resolution"}}}}]}
  }
}
