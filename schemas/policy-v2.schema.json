{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_version", "release_service", "scope", "ai", "incident_history", "profile_for_tier", "rollout", "profiles", "trusted_probe_catalog", "job_analysis"],
  "properties": {
    "schema_version": {"const": "2"},
    "policy_version": {"const": "2026.08.3"},
    "release_service": {"const": {"name": "demo-api", "replicas": 5, "critical": false, "downstream_dependents": [], "path_prefixes": ["src/demo_api/"]}},
    "scope": {"const": {"small_max_files": 2, "small_max_lines": 50, "large_min_files": 10, "large_min_lines": 500}},
    "ai": {"const": {"provider": "ollama", "model": "qwen2.5-coder:7b", "max_diff_bytes": 16384, "timeout_seconds": 60, "attempts": 1, "temperature": 0, "seed": 42, "num_ctx": 8192, "num_predict": 768, "accepted_finding_kinds": ["breaking_api"]}},
    "incident_history": {"const": {"enabled": false}},
    "profile_for_tier": {"const": {"safe": "Fast", "guarded": "Guarded", "risky": "Strict"}},
    "rollout": {"const": {"traffic_router": "none", "max_surge": 1, "max_unavailable": 0}},
    "profiles": {"const": {
      "Fast": {"source": "built_in", "stages": [{"set_weight": 100, "exposure_pods": 5, "analysis": false}], "analysis": null},
      "Guarded": {"source": "built_in", "stages": [{"set_weight": 40, "exposure_pods": 2, "analysis": true}, {"set_weight": 100, "exposure_pods": 5, "analysis": false}], "analysis_probe_id": "demo-api-public-quote-v1"},
      "Strict": {"source": "built_in", "stages": [{"set_weight": 20, "exposure_pods": 1, "analysis": true}, {"set_weight": 40, "exposure_pods": 2, "analysis": true}, {"set_weight": 60, "exposure_pods": 3, "analysis": true}, {"set_weight": 100, "exposure_pods": 5, "analysis": false}], "analysis_probe_id": "demo-api-public-quote-v1"}
    }},
    "trusted_probe_catalog": {"const": {"path": "demo/trusted-probes.yaml", "non_fast_fallback_probe_id": "demo-api-public-quote-v1"}},
    "job_analysis": {"const": {"attempts": 3, "interval_seconds": 10, "failure_allowance": 1, "request_timeout_seconds": 2, "active_deadline_seconds": 45}}
  }
}
