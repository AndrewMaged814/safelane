{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safelane.dev/schemas/repository-trusted-probes-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "probes"],
  "properties": {
    "schema_version": {"const": "1"},
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "analysis_template", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/dns_label"},
          "analysis_template": {"$ref": "#/$defs/dns_label"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "dns_label": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"}
  }
}
